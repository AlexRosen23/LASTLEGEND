{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/last-legend/athlete.schema.json",
  "title": "Last Legend Athlete Draft",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "sport",
    "appearance",
    "ratings",
    "fictional_behavior",
    "signature_perk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "display_name": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "appearance": {
      "type": "object",
      "required": [
        "outfit_type",
        "display_number",
        "verification_status"
      ],
      "properties": {
        "outfit_type": {
          "type": "string"
        },
        "display_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "enum": [
            "NEEDS_REVIEW",
            "VERIFIED",
            "REJECTED"
          ]
        }
      }
    },
    "ratings": {
      "type": "object",
      "required": [
        "strength",
        "acceleration",
        "top_speed",
        "agility",
        "endurance",
        "durability",
        "reflexes",
        "coordination",
        "balance",
        "recovery",
        "striking",
        "grappling",
        "combat_defense",
        "tactical_iq",
        "awareness",
        "composure",
        "adaptability",
        "resourcefulness",
        "leadership",
        "clutch"
      ],
      "properties": {
        "strength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "acceleration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "top_speed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "agility": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "endurance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "durability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "reflexes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "coordination": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "balance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "recovery": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "striking": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "grappling": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "combat_defense": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "tactical_iq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "awareness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "composure": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "adaptability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "resourcefulness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "leadership": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "clutch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "fictional_behavior": {
      "type": "object",
      "required": [
        "aggression",
        "caution",
        "alliance_drive",
        "loyalty",
        "opportunism"
      ],
      "properties": {
        "aggression": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "caution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "alliance_drive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "loyalty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "opportunism": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "signature_perk": {
      "type": "string"
    }
  }
}